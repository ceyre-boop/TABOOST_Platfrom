rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isCreator() {
      return isAuthenticated() && getUserRole() == 'creator';
    }
    
    // Users collection - personal account data
    match /users/{userId} {
      // Users can read their own data
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own data (but not role)
      allow update: if isAuthenticated() 
        && isOwner(userId)
        && request.resource.data.role == resource.data.role;
      
      // Users can create their own document during signup
      // Must have role: "creator" and match their auth uid
      allow create: if isAuthenticated() 
        && isOwner(userId)
        && request.resource.data.role == 'creator';
      
      // Admins can read all users
      allow read: if isAdmin();
      
      // Admins can create users
      allow create: if isAdmin();
    }
    
    // Creator roster - pre-approved creators
    match /creatorRoster/{username} {
      // ANYONE can read roster (to check if username exists before signup)
      // This is safe because roster only contains: cid, username, claimed status
      allow read: if true;
      
      // Only admins can create roster entries
      allow create: if isAdmin();
      
      // Allow users to update their own entry to mark as claimed.
      // They can ONLY flip claimed:false->true, set their own uid, and stamp claimedAt.
      // affectedKeys().hasOnly(...) blocks injecting/overwriting any other roster field.
      allow update: if isAuthenticated()
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'uid', 'claimedAt', 'claimedBy']);

      // Admins can do anything
      allow delete: if isAdmin();
    }
    
    // Creator data - performance metrics
    match /creators/{cid} {
      // Creator can read their own data. Primary link: their users/{uid}.cid == this doc id.
      // (creators docs are synced from Sheets and don't carry a uid; the uid->cid mapping
      //  lives on the user's own account doc, written at signup/claim.)
      allow read: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cid == cid;

      // Legacy fallback: some docs may carry a uid field directly.
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;

      // Admin can read all creator data
      allow read: if isAdmin();

      // Admin can write creator data
      allow write: if isAdmin();
    }

    // ===== UK region (mirrors creatorRoster / creators) =====
    // Auth (users) and roles are shared US+UK; only the data collections are namespaced.

    // UK creator roster - pre-approved UK creators
    match /ukCreatorRoster/{username} {
      // ANYONE can read roster (to check if username exists before signup)
      allow read: if true;

      // Only admins can create roster entries
      allow create: if isAdmin();

      // Allow users to claim their own entry (set claimed: true + their uid).
      // hasOnly(...) blocks injecting/overwriting any other roster field.
      allow update: if isAuthenticated()
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'uid', 'claimedAt', 'claimedBy']);

      // Admins can do anything
      allow delete: if isAdmin();
    }

    // UK creator data - performance metrics
    match /ukCreators/{cid} {
      // Creator can read their own data. Primary link: their users/{uid}.cid == this doc id.
      allow read: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cid == cid;

      // Legacy fallback: some docs may carry a uid field directly.
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;

      // Admin can read all UK creator data
      allow read: if isAdmin();

      // Admin can write UK creator data
      allow write: if isAdmin();
    }

    // Admin collection - isolated admin data
    match /admins/{adminId} {
      // Only the specific admin can read their data
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      
      // Only admins can read other admin data
      allow read: if isAdmin();
    }
    
    // Signup audit log
    match /signups/{docId} {
      // Anyone can create (for logging)
      allow create: if isAuthenticated();
      
      // Only admins can read
      allow read: if isAdmin();
    }
    
    // Analytics data
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Payouts
    match /payouts/{docId} {
      // Creator can read their own payouts
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;

      // Admin can manage all payouts
      allow read, write: if isAdmin();
    }

    // Marco CEO cockpit — GPT Command Center learning memory (admin only)
    match /marco_memory/{docId} {
      allow read, write: if isAdmin();
    }

    // Marco CEO cockpit — integration API keys (admin only; keeps keys out of the public source)
    match /marco_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Agency Cash Bonus claims — one create-only doc per (creator, month), id = "{uid}_{YYYY-MM}".
    // Create-only is the anti-double-claim guard: a re-claim would be an update, which no rule allows.
    // ⚠️ SHARED 'taboost-platform' project (also used by TABOOST-Shop). The DEPLOYED ruleset must
    //    ALSO include Shop's tapBonusClaims rule — do NOT publish a ruleset that drops either one.
    match /cashbackClaims/{claimId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'creatorName', 'month', 'claimedAt']);
      allow read, write: if isAdmin();
    }

    // ⚠️ SHARED PROJECT — TABOOST-Shop collection. Kept here so this ruleset is the
    // complete deployable set for the shared 'taboost-platform' project. Do NOT drop.
    // TAP bonus claims — one doc per (creator, tier), id = "{uid}_{tier}". Create-only:
    // a re-claim of the same tier is an update on an existing doc, which no rule allows.
    // No dollar field permitted; amount is resolved server-side (Apps Script) from tier.
    match /tapBonusClaims/{claimId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'tier', 'creatorName', 'claimedAt'])
        && request.resource.data.tier in ['tier1', 'tier2', 'tier3'];

      allow read, write: if isAdmin();
    }
  }
}
